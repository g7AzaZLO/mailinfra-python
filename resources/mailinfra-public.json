      "BounceCategory": {
        "description": "Нормализованная причина bounce — для UI/Debug Explorer.\n\nОтдельно от BounceType (hard/soft): категория даёт человекочитаемую\nпричину, вычисляется классификатором по enhanced-коду/тексту диагностики.\nСм. app.services.bounce_parser.classify_bounce_category.",
        "enum": [
          "invalid-recipient",
          "mailbox-full",
          "message-too-large",
          "content-spam-block",
          "policy-rejection",
          "reputation-blocklist",
          "greylisting",
          "dns-mx-failure",
          "connection-error",
          "rate-limited",
          "auth-failure",
          "unknown"
